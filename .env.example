# Local credentials — NEVER commit this file.
# Two layers of protection: .gitignore excludes it, and the pre-commit hook blocks
# it (and any credential-shaped content) even if force-added.
# Fill in the values; leave unused providers empty.

# Google AI (Gemini) — required for --provider gemini / docker compose
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provider used by the runner and Docker (local|anthropic|openai|gemini|meta|openrouter|groq)
AI_PROVIDER=gemini

# Optional providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
META_API_KEY=
META_MODEL=muse-spark-1.2
OPENROUTER_API_KEY=
# No default model (unlike the providers above): which family (Llama, Qwen, Claude, ...)
# OpenRouter routes to must be set explicitly per experiment, e.g. meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=
GROQ_API_KEY=
# No default model (unlike the providers above): which family (OpenAI's open-weights models,
# Llama, Qwen, ...) Groq routes to must be set explicitly per experiment, e.g.
# openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_MODEL=

# LangSmith tracing (optional — silent no-op when empty; console metrics never depend on it)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-platform-reference

# Optional infrastructure
REDIS_URL=
ERP_BASE_URL=

# MCP server credentials (absent -> deterministic stub, by design)
GMAIL_CREDENTIALS_PATH=
WHATSAPP_TOKEN=
